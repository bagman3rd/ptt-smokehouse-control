DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Required. At least 12 characters. Used only to seed/reset the initial admin account.
ADMIN_PASSWORD="replace-with-a-long-random-admin-password"
# Required. At least 12 characters. Use a long random token. No dev fallback is used.
APP_SESSION_TOKEN="replace-with-a-long-random-session-token"
NEXT_PUBLIC_APP_NAME="Smokehouse Control"
# Required for scheduled backup endpoint / Render Cron.
CRON_SECRET="replace-with-a-long-random-cron-secret"
# Base URL for Render Cron runner, e.g. https://ptt-smokehouse-control.onrender.com
BACKUP_APP_URL="https://example.onrender.com"
# Optional webhook/storage endpoint that receives tenant JSON backup payloads.
BACKUP_POST_URL=""
# Build 4.4.0 commercial readiness
NEXT_PUBLIC_SUPPORT_EMAIL=support@smokehousecontrol.com
STRIPE_PAYMENT_LINK=
STRIPE_CHECKOUT_URL=
# Build 5.2.0 commercial SaaS readiness
STRIPE_MONTHLY_PAYMENT_LINK=
STRIPE_ANNUAL_PAYMENT_LINK=
STRIPE_CUSTOMER_PORTAL_URL=
STRIPE_PORTAL_URL=

# Founding-customer billing policy
BILLING_MODE=MANUAL_INVOICE
BILLING_CONTACT_EMAIL=

# 32+ character key used to encrypt authenticator secrets. Set before enabling production 2FA.
TOTP_ENCRYPTION_KEY=replace-with-a-separate-strong-32-character-key

# Archer support chatbot (Build 9.1.1)
OPENAI_API_KEY=
ARCHER_OPENAI_MODEL=gpt-5-mini
ARCHER_MAX_OUTPUT_TOKENS=350
ARCHER_REQUESTS_PER_MINUTE=12

# ============================================================
# Build 10.0.0 — compliance, notifications, cost, observability
# ============================================================

# Public base URL of the app (used for unsubscribe + deletion confirmation links).
APP_BASE_URL="https://app.smokehousecontrol.com"

# CAN-SPAM: physical postal address included in every commercial email footer.
COMPANY_POSTAL_ADDRESS="Smokehouse Control, 937 N Central St, Knoxville, TN 37917"

# Email provider (SendGrid). Leave blank in dev/test to use the console provider (no real sends).
SENDGRID_API_KEY=
NOTIFY_FROM_EMAIL=no-reply@smokehousecontrol.com

# SMS provider (Twilio). Leave blank in dev/test to use the console provider (no real sends).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The public URL Twilio posts inbound SMS to (used for signature validation).
TWILIO_INBOUND_WEBHOOK_URL=

# Operations digest recipient + timezone (daily-digest cron).
OPS_ALERT_EMAIL=
OPS_TIMEZONE=America/New_York

# AI cost controls (Archer). Cents unless noted.
AI_DAILY_CENTS_CAP=200            # per-restaurant daily AI spend cap ($2.00)
AI_DAILY_ALERT_CENTS=1000         # account-wide daily alert threshold ($10.00)
AI_MAX_TOKENS_PER_CONVERSATION=8000
# Optional pricing overrides (cents per 1M tokens).
AI_PROMPT_CENTS_PER_MTOK=300
AI_COMPLETION_CENTS_PER_MTOK=1500
