{
  "buildVersion": "12.0.0",
  "engineVersion": "PTT_PRODUCTION_RELEASE_12_0_0",
  "stage": "PTT Production Release",
  "exitGate": "Production authorization requires deployed staging evidence showing every core workflow is durable, authorized, tenant-isolated, navigable, observable, recoverable, and accepted with no open P0/P1 defect.",
  "releaseStatusModel": {
    "packageStatus": [
      "COMPLETE",
      "INCOMPLETE"
    ],
    "evidenceDecision": [
      "GO",
      "HOLD"
    ],
    "productionAuthorization": [
      "PENDING_DEPLOYED_SIGN_OFF",
      "AUTHORIZED",
      "REJECTED"
    ],
    "deterministicGoNeverGrantsProductionAuthorization": true
  },
  "requiredBuilds": [
    "11.1.0",
    "11.2.0",
    "11.3.0",
    "11.4.0",
    "11.5.0",
    "11.6.0",
    "11.7.0",
    "11.8.0",
    "11.9.0"
  ],
  "coreWorkflows": [
    "SETUP_MASTER_DATA",
    "FORECAST_DEMAND",
    "PRODUCTION_SMOKER_SCHEDULING",
    "TODAY_OPERATIONS",
    "QUICK_EOD",
    "INVENTORY_WASTE_EXCEPTIONS",
    "REPORTING_FORECAST_LEARNING",
    "NOTIFICATIONS_ADMINISTRATION"
  ],
  "requiredRoutes": [
    "/",
    "/onboarding",
    "/forecast",
    "/production",
    "/today",
    "/eod",
    "/inventory",
    "/reports",
    "/admin"
  ],
  "requiredApiDomains": [
    "HEALTH",
    "AUTHENTICATION",
    "FORECAST",
    "PRODUCTION",
    "TODAY",
    "EOD",
    "INVENTORY",
    "REPORTING",
    "ADMINISTRATION"
  ],
  "workflowRequirements": {
    "normalNavigationRequired": true,
    "durableDatabaseWritesRequired": true,
    "serverAuthorizationRequired": true,
    "tenantIsolationRequired": true,
    "idempotencyRequiredForMutations": true,
    "appendOnlyAuditRequired": true,
    "deployedUatRequired": true,
    "noOpenP0OrP1": true
  },
  "validationRoutePolicy": {
    "productionExposureAllowed": [
      "DISABLED",
      "ADMIN_ONLY"
    ],
    "publicExposureBlocksRelease": true,
    "routePrefixes": [
      "/inventory-lab-",
      "/forecast-lab-",
      "/production-lab-",
      "/today-lab-",
      "/reports-lab-",
      "/admin-lab-",
      "/hardening-lab-",
      "/release-lab-"
    ]
  },
  "productionConfiguration": {
    "nodeEnvironment": "production",
    "debugModeAllowed": false,
    "testFixturesAllowed": false,
    "sandboxPaymentsAllowed": false,
    "requiredConfigurationPresence": [
      "DATABASE_URL",
      "ADMIN_PASSWORD",
      "APP_SESSION_TOKEN",
      "TOTP_ENCRYPTION_KEY"
    ],
    "secretValuesMustNeverBeExported": true
  },
  "deployment": {
    "exactGitCommitRequired": true,
    "exactRenderRevisionRequired": true,
    "healthEndpointRequired": true,
    "databaseReachableRequired": true,
    "migrationStatus": "CURRENT",
    "buildIdentityRequired": true,
    "httpsRequired": true,
    "customDomainRequired": true
  },
  "renderTopology": {
    "webServices": 1,
    "cronServices": 0,
    "databases": 1,
    "cronServicesForbidden": true
  },
  "dataContinuity": {
    "currentVerifiedBackupRequired": true,
    "restoreDrillRequired": true,
    "rollbackTestRequired": true,
    "dataReconciliationRequired": true,
    "rpoHours": 24,
    "rtoHours": 4
  },
  "launchOperations": {
    "releaseOwnerRequired": true,
    "operationsOwnerRequired": true,
    "supportOwnerRequired": true,
    "incidentOwnerRequired": true,
    "openingDayChecklistRequired": true,
    "firstDayMonitoringRequired": true,
    "supportRunbookRequired": true,
    "rollbackRunbookRequired": true
  },
  "signOffRoles": [
    "RELEASE_OWNER",
    "OPERATIONS_OWNER",
    "SECURITY_TESTER",
    "QA_TESTER",
    "RECOVERY_TESTER"
  ],
  "releaseGate": {
    "openP0Allowed": 0,
    "openP1Allowed": 0,
    "failedWorkflowControlsAllowed": 0,
    "failedDeploymentControlsAllowed": 0,
    "failedSecurityControlsAllowed": 0,
    "failedRecoveryControlsAllowed": 0,
    "failedLaunchControlsAllowed": 0
  },
  "scopeBoundary": [
    "This overlay is a production-release certification and cutover package.",
    "It does not fabricate durable database integrations in an unavailable repository.",
    "It does not authorize production based only on deterministic fixtures.",
    "It does not perform a Render deployment, database migration, backup, restore, rollback, or live load test.",
    "Production authorization remains pending until deployed evidence is signed."
  ]
}
