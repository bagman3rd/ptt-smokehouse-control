  "canonicalRoles": [
    {
      "code": "ADMIN",
      "label": "Admin",
      "authority": "Platform and tenant administration, security, feature flags, system configuration and support.",
      "restriction": "May not silently alter operational history."
    },
    {
      "code": "OWNER",
      "label": "Owner",
      "authority": "Full restaurant visibility, approvals, reports, assumptions and overrides.",
      "restriction": "Financial and operational authority."
    },
    {
      "code": "KM",
      "label": "Kitchen Manager",
      "authority": "Forecast review, production approval, staffing coordination, EOD review and exception closure.",
      "restriction": "Primary daily operating owner."
    },
    {
      "code": "KC",
      "label": "Kitchen Coordinator",
      "authority": "Execute plans, update status, complete counts and record exceptions.",
      "restriction": "No tenant or security administration."
    },
    {
      "code": "PITMASTER",
      "label": "Pitmaster",
      "authority": "Smoker loads, temperatures, timing, holds, yields and product quality status.",
      "restriction": "No finance or security administration."
    },
    {
      "code": "VIEWER",
      "label": "Viewer",
      "authority": "Read-only access to approved dashboards and reports.",
      "restriction": "No operational edits."
    }
  ],
